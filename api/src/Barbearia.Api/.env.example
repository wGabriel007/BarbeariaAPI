# Copie este arquivo para ".env" (mesma pasta, ao lado deste
# .env.example) e troque os valores pelos de verdade. O ".env" NUNCA
# deve ir pro Git (já está no .gitignore da pasta api/) — é exatamente
# por isso que existe o .env.example: ele sim pode ser commitado, com
# valores de exemplo, servindo de "modelo" pra quem clonar o projeto.
#
# Formato: "__" (dois underscores) representa o ":" de uma chave de
# configuração aninhada. ConnectionStrings__Barbearia é a mesma coisa
# que "ConnectionStrings": { "Barbearia": "..." } no appsettings.json.

# Dados do Postgres criado na Fase 1 (pasta ../../../database)
ConnectionStrings__Barbearia=Host=localhost;Port=5432;Database=barbearia;Username=postgres;Password=SUA_SENHA_AQUI

# Precisa ter pelo menos 32 caracteres — é a chave que assina o token de
# login (ver LEIA-ME.md). Gere uma string aleatória sua, não reaproveite
# esta aqui em produção.
Jwt__Key=troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres
